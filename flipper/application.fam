App(
    appid="teslacan",
    name="TeslaCAN",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="teslacan_app_main",
    requires=["gui"],
    stack_size=4 * 1024,
    fap_category="Tools",
    fap_author="tuncasoftbildik",
